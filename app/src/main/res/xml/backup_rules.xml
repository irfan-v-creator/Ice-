<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude local Room SQLite databases, session safety markers, and pre-migration backups
         from Google Auto Backup to prevent cross-account contamination and stale WAL restore -->
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="icetrack_session_safety_prefs.xml"/>
    <exclude domain="file" path="legacy_backups"/>
</full-backup-content>
